# Chemgraph Environment Configuration
# =============================================================================
# COPY THIS FILE TO .env AND FILL IN THE VALUES
# NEVER COMMIT .env TO GIT - IT'S IN .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# GHOST CMS CONFIGURATION
# -----------------------------------------------------------------------------
# Ghost version (pinned for reproducible builds)
GHOST_VERSION=5.100

# Node environment: development | production
NODE_ENV=development

# Public URL of your site (CHANGE FOR PRODUCTION)
# For local testing without domain: http://localhost
# With Cloudflare Tunnel: https://chemgraph.ru
GHOST_URL=http://localhost

# Admin panel URL
GHOST_ADMIN_URL=http://localhost/ghost

# -----------------------------------------------------------------------------
# DATABASE (MYSQL 8) - REQUIRED (Ghost doesn't support SQLite in production)
# -----------------------------------------------------------------------------
# Root password (use strong password in production!)
MYSQL_ROOT_PASSWORD=changeme_root_strong_password_here

# Database name
MYSQL_DATABASE=ghost

# Database user
MYSQL_USER=ghost

# Database user password (use strong password in production!)
MYSQL_PASSWORD=changeme_ghost_password_here

# -----------------------------------------------------------------------------
# REDIS (Caching & Sessions)
# -----------------------------------------------------------------------------
# Redis password (use strong password in production!)
REDIS_PASSWORD=changeme_redis_password_here

# -----------------------------------------------------------------------------
# EMAIL (SMTP) - REQUIRED for member signup, newsletters, invites
# -----------------------------------------------------------------------------
# SMTP transport: SMTP | Sendmail
MAIL_TRANSPORT=SMTP

# SMTP host (examples: smtp.yandex.ru, smtp.mailgun.org, smtp.brevo.com)
SMTP_HOST=smtp.yandex.ru

# SMTP port: 465 (SSL) | 587 (STARTTLS) | 25
SMTP_PORT=465

# Use SSL/TLS: true | false
SMTP_SECURE=true

# SMTP username (usually your email)
SMTP_USER=your-email@yandex.ru

# SMTP password (app password, not your login password!)
SMTP_PASS=your-app-password-here

# From address for outgoing emails
SMTP_FROM="Chemgraph <noreply@chemgraph.ru>"

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# JWT secret for member authentication (generate: openssl rand -base64 32)
JWT_SECRET=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# CLOUDFLARE TUNNEL (for public HTTPS access)
# -----------------------------------------------------------------------------
# Tunnel token from Cloudflare Dashboard (after tunnel creation)
# Leave empty for local-only development
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL: EXTERNAL SERVICES (Phase 3+)
# -----------------------------------------------------------------------------
# LLM API for newsletter bridge (OpenRouter, Anthropic, etc.)
# OPENROUTER_API_KEY=

# Stripe for paid memberships
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# Sentry for error tracking
# SENTRY_DSN=

# Analytics (Umami/Plausible self-hosted)
# ANALYTICS_URL=
# ANALYTICS_SITE_ID=

# -----------------------------------------------------------------------------
# DEVELOPMENT OVERRIDES (uncomment for local tweaks)
# -----------------------------------------------------------------------------
# Ghost config overrides (advanced)
# GHOST_CONFIG_OVERRIDES=

# Debug logging
# LOG_LEVEL=debug